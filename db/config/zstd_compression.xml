<?xml version="1.0"?>
<clickhouse>
    <!-- ZSTD compression configuration for float columns -->
    <compression>
        <case>
            <method>zstd</method>
            <level>1</level>
        </case>
    </compression>
    
    <!-- Default compression settings for MergeTree engines -->
    <merge_tree>
        <compress_marks>true</compress_marks>
        <compress_primary_key>true</compress_primary_key>
    </merge_tree>
</clickhouse>
